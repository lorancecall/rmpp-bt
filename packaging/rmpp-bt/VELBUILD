# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. Scripts never restart xochitl themselves: they re-arm
# the transient timer rmpp-restart-xochitl (15 s, runs /usr/lib/rmpp/restart), so a transaction restarts it once.
# Root file system: everything under /usr/lib/rmpp (rmpp-preload's layout); a file xochitl may have loaded is
# renamed to *.old or moved to /usr/lib/rmpp/.trash, never deleted, and /usr/lib/rmpp/restart deletes it after the
# restart. Plain `mount -o remount,rw|ro /`: Vellum's mount-rw unmounts /etc recursively, which also drops the
# /etc/dropbear bind mount (SSH host key) until the next boot.
# Boot: /usr/lib/rmpp/boot.d/50-rmpp-bt copies the two units to /run/systemd/system and loads the driver.

package() {
	install -Dm755 "$srcdir"/librmpp-bt.so "$pkgdir"/home/root/.vellum/share/rmpp-bt/librmpp-bt.so
	install -Dm644 "$srcdir"/rmpp-bt.rcc "$pkgdir"/home/root/.vellum/share/rmpp-bt/rmpp-bt.rcc
	install -Dm755 "$srcdir"/reconnect "$pkgdir"/home/root/.vellum/share/rmpp-bt/reconnect
	install -Dm644 "$srcdir"/rmpp-bluetooth.service "$pkgdir"/home/root/.vellum/share/rmpp-bt/rmpp-bluetooth.service
	install -Dm644 "$srcdir"/rmpp-bt-reconnect.service "$pkgdir"/home/root/.vellum/share/rmpp-bt/rmpp-bt-reconnect.service
	install -Dm644 "$srcdir"/rmpp-bt.env "$pkgdir"/home/root/.vellum/share/rmpp-bt/rmpp-bt.env
	install -Dm755 "$srcdir"/boot "$pkgdir"/home/root/.vellum/share/rmpp-bt/boot

	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/$upstream_author/rmpp-bt" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	mount -o remount,rw /
	# older versions put files in /usr/lib/rmpp-bt, /usr/lib/systemd/system/rmpp-bluetooth.service: set aside (deleted after the restart)
	if [ -e /usr/lib/rmpp-bt ] || [ -e /usr/lib/systemd/system/rmpp-bluetooth.service ]; then
		mkdir -p /usr/lib/rmpp/.trash
		rm -f /usr/lib/rmpp-preload.d/50-rmpp-bt.so /usr/lib/systemd/system/multi-user.target.wants/rmpp-bluetooth.service /usr/lib/systemd/system/rmpp-bluetooth.service /usr/lib/systemd/system/rmpp-bt-reconnect.service
		[ ! -e /usr/lib/rmpp-bt ] || mv /usr/lib/rmpp-bt /usr/lib/rmpp/.trash/usr_lib_rmpp-bt.$$
		[ ! -e /usr/lib/systemd/system/rmpp-bluetooth.service ] || mv /usr/lib/systemd/system/rmpp-bluetooth.service /usr/lib/rmpp/.trash/usr_lib_systemd_system_rmpp-bluetooth.service.$$
	fi
	mkdir -p /usr/lib/rmpp/rmpp-bt /usr/lib/rmpp/preload.d /usr/lib/rmpp/env.d /usr/lib/rmpp/boot.d /usr/lib/rmpp/units/rmpp-bt
	cp "/home/root/.vellum/share/rmpp-bt"/librmpp-bt.so /usr/lib/rmpp/rmpp-bt/librmpp-bt.so.new && chmod 755 /usr/lib/rmpp/rmpp-bt/librmpp-bt.so.new && { [ ! -e /usr/lib/rmpp/rmpp-bt/librmpp-bt.so ] || mv -f /usr/lib/rmpp/rmpp-bt/librmpp-bt.so /usr/lib/rmpp/rmpp-bt/librmpp-bt.so.old; } && mv -f /usr/lib/rmpp/rmpp-bt/librmpp-bt.so.new /usr/lib/rmpp/rmpp-bt/librmpp-bt.so
	cp "/home/root/.vellum/share/rmpp-bt"/rmpp-bt.rcc /usr/lib/rmpp/rmpp-bt/rmpp-bt.rcc.new && chmod 644 /usr/lib/rmpp/rmpp-bt/rmpp-bt.rcc.new && { [ ! -e /usr/lib/rmpp/rmpp-bt/rmpp-bt.rcc ] || mv -f /usr/lib/rmpp/rmpp-bt/rmpp-bt.rcc /usr/lib/rmpp/rmpp-bt/rmpp-bt.rcc.old; } && mv -f /usr/lib/rmpp/rmpp-bt/rmpp-bt.rcc.new /usr/lib/rmpp/rmpp-bt/rmpp-bt.rcc
	cp "/home/root/.vellum/share/rmpp-bt"/reconnect /usr/lib/rmpp/rmpp-bt/reconnect.new && chmod 755 /usr/lib/rmpp/rmpp-bt/reconnect.new && { [ ! -e /usr/lib/rmpp/rmpp-bt/reconnect ] || mv -f /usr/lib/rmpp/rmpp-bt/reconnect /usr/lib/rmpp/rmpp-bt/reconnect.old; } && mv -f /usr/lib/rmpp/rmpp-bt/reconnect.new /usr/lib/rmpp/rmpp-bt/reconnect
	ln -sfn ../rmpp-bt/librmpp-bt.so /usr/lib/rmpp/preload.d/50-rmpp-bt.so
	cp "/home/root/.vellum/share/rmpp-bt"/rmpp-bt.env /usr/lib/rmpp/env.d/rmpp-bt.env.new && chmod 644 /usr/lib/rmpp/env.d/rmpp-bt.env.new && { [ ! -e /usr/lib/rmpp/env.d/rmpp-bt.env ] || mv -f /usr/lib/rmpp/env.d/rmpp-bt.env /usr/lib/rmpp/env.d/rmpp-bt.env.old; } && mv -f /usr/lib/rmpp/env.d/rmpp-bt.env.new /usr/lib/rmpp/env.d/rmpp-bt.env
	cp "/home/root/.vellum/share/rmpp-bt"/boot /usr/lib/rmpp/boot.d/50-rmpp-bt.new && chmod 755 /usr/lib/rmpp/boot.d/50-rmpp-bt.new && { [ ! -e /usr/lib/rmpp/boot.d/50-rmpp-bt ] || mv -f /usr/lib/rmpp/boot.d/50-rmpp-bt /usr/lib/rmpp/boot.d/50-rmpp-bt.old; } && mv -f /usr/lib/rmpp/boot.d/50-rmpp-bt.new /usr/lib/rmpp/boot.d/50-rmpp-bt
	cp "/home/root/.vellum/share/rmpp-bt"/rmpp-bluetooth.service /usr/lib/rmpp/units/rmpp-bt/rmpp-bluetooth.service.new && chmod 644 /usr/lib/rmpp/units/rmpp-bt/rmpp-bluetooth.service.new && { [ ! -e /usr/lib/rmpp/units/rmpp-bt/rmpp-bluetooth.service ] || mv -f /usr/lib/rmpp/units/rmpp-bt/rmpp-bluetooth.service /usr/lib/rmpp/units/rmpp-bt/rmpp-bluetooth.service.old; } && mv -f /usr/lib/rmpp/units/rmpp-bt/rmpp-bluetooth.service.new /usr/lib/rmpp/units/rmpp-bt/rmpp-bluetooth.service
	cp "/home/root/.vellum/share/rmpp-bt"/rmpp-bt-reconnect.service /usr/lib/rmpp/units/rmpp-bt/rmpp-bt-reconnect.service.new && chmod 644 /usr/lib/rmpp/units/rmpp-bt/rmpp-bt-reconnect.service.new && { [ ! -e /usr/lib/rmpp/units/rmpp-bt/rmpp-bt-reconnect.service ] || mv -f /usr/lib/rmpp/units/rmpp-bt/rmpp-bt-reconnect.service /usr/lib/rmpp/units/rmpp-bt/rmpp-bt-reconnect.service.old; } && mv -f /usr/lib/rmpp/units/rmpp-bt/rmpp-bt-reconnect.service.new /usr/lib/rmpp/units/rmpp-bt/rmpp-bt-reconnect.service
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	/usr/lib/rmpp/boot.d/50-rmpp-bt
	systemctl restart rmpp-bt-reconnect.service 2>/dev/null || true
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins. The restart
	# waits until apk.vellum has exited (a large package can outlast the timer); a restart already waiting
	# covers this package too, so never restart directly while one is active.
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemctl is-active -q rmpp-restart-xochitl.service || \
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c 'i=0; while pidof apk.vellum >/dev/null && [ $i -lt 900 ]; do sleep 1; i=$((i + 1)); done; [ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
}

