	systemctl stop rmpp-bt-reconnect.service rmpp-bluetooth.service 2>/dev/null || true
	rm -f /run/systemd/system/rmpp-bluetooth.service /run/systemd/system/rmpp-bt-reconnect.service
	systemctl daemon-reload
	mount -o remount,rw /
	mkdir -p /usr/lib/rmpp/.trash
	rm -f /usr/lib/rmpp/preload.d/50-rmpp-bt.so /usr/lib/rmpp/env.d/rmpp-bt.env /usr/lib/rmpp/boot.d/50-rmpp-bt
	rm -rf /usr/lib/rmpp/units/rmpp-bt
	[ ! -e /usr/lib/rmpp/rmpp-bt ] || mv /usr/lib/rmpp/rmpp-bt /usr/lib/rmpp/.trash/rmpp-bt.$$
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins. The restart
	# waits until apk.vellum has exited (a large package can outlast the timer); a restart already waiting
	# covers this package too, so never restart directly while one is active.
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemctl is-active -q rmpp-restart-xochitl.service || \
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c 'i=0; while pidof apk.vellum >/dev/null && [ $i -lt 900 ]; do sleep 1; i=$((i + 1)); done; [ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.config/rmpp-bt
	fi
}
